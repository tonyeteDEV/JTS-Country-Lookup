{
  "name": "jts-country-lookup",
  "version": "1.0.13",
  "description": "PCF control that turns a plain text column into a searchable country picker, with no Dataverse table or plugin dependency.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "build": "pcf-scripts build",
    "build:production": "pcf-scripts build --buildMode production",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:production",
    "clean": "pcf-scripts clean",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "test": "node --import tsx --test tests/countries.test.ts tests/release-contract.test.ts",
    "test:coverage": "node --experimental-test-coverage --import tsx --test tests/countries.test.ts tests/release-contract.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "react": "18.2.0",
    "@fluentui/react-components": "9.46.2",
    "@fluentui/react-icons": "2.0.334",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@microsoft/eslint-plugin-power-apps": "0.2.51",
    "@types/node": "22.15.3",
    "@types/powerapps-component-framework": "1.3.18",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "pcf-scripts": "1.51.1",
    "pcf-start": "1.51.1",
    "tsx": "4.20.6",
    "typescript": "4.9.5"
  }
}
